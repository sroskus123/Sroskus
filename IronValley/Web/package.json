{
  "name": "iron-valley-web",
  "version": "0.1.0",
  "private": true,
  "description": "IRON VALLEY - hratelna prohlizecova verze (three.js, cisty JavaScript bez WebAssembly). Neni to verze pro Unreal Engine.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "test": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "three-pathfinding": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
