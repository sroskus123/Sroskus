        { "op": "kill", "id": "a1", "expect": { "result": "round_ended", "respawn": { "participants": { "a1": { "state": "alive" } } } } },
        { "op": "damage", "id": "a1", "amount": 50, "attacker": "b1", "expect": { "result": { "result": "round_ended", "applied": 0 }, "respawn": { "participants": { "a1": { "health": 100 } } } } },
