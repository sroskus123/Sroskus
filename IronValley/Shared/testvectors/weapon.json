    {
      "id": "GUN-01/fire-from-full",
      "kind": "weapon",
      "setup": { "weapon": "rifle_iv7" },
      "steps": [
        { "op": "tick", "dtUs": 0, "expect": { "result": 0, "events": [], "state": "ready", "magazine": 30, "chamber": 1, "reserve": 90, "initialTotal": 121, "fireMode": "auto", "shotsFired": 0 } },
        { "op": "tick", "dtUs": 16667, "trigger": true, "expect": { "result": 1, "events": [{ "type": "shot", "atUs": 0, "detail": "" }], "magazine": 29, "chamber": 1, "reserve": 90, "shotsFired": 1, "cooldownUs": 63333, "clockUs": 16667, "holdValid": true } },
        { "op": "tick", "dtUs": 16667, "expect": { "result": 0, "events": [], "holdValid": false, "cooldownUs": 46666, "magazine": 29 } }
      ]
    },
    {
      "id": "GUN-01/zero-length-tick-fires-nothing",
